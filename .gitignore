# build output
/target

# project state and render cache (never authoritative)
/.splice
/demo

# local media and proof artefacts: inputs and evidence stay out of the repo.
# `splice` and the verify skill generate their own fixtures with ffmpeg.
/resource
/verification

# secrets: keys live in the environment, never in the tree
.env
*.tmp

# npm packaging output: staged per-platform packages, built from a release binary
/npm/out
